{
  "$schema": "https://www.schemastore.org/prettierrc.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"tabWidth": 4,
	"printWidth": 120,
	"htmlWhitespaceSensitivity": "ignore",
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	]
}
